# Copy to .env and restart Vitreign.
# Leave both Immich settings blank for the local sample library.
IMMICH_URL=
IMMICH_API_KEY=
# Optional, absolute path to an existing private Immich Docker Compose file.
IMMICH_COMPOSE_FILE=
# Optional HTTPS Immich address for creating 24-hour guest links.
IMMICH_SHARE_ORIGIN=
# Set to 1 only if the scoped key has asset.download.
VITREIGN_ORIGINALS=0
# Optional absolute folders monitored by Archive. A marker verifies the volume.
# VITREIGN_STORAGE_ROOTS='[{"name":"Archive drive","path":"E:/Media","marker":"studio-drive-01"}]'
# Required when connected. Generate with: node -p "require('node:crypto').randomBytes(32).toString('hex')"
VITREIGN_ACCESS_KEY=
# Optional, exact HTTPS origin when behind a loopback reverse proxy.
VITREIGN_ORIGIN=
PORT=4173
